{
    "name": "cleverage/process-bundle-demo",
    "type": "project",
    "description": "A demo project using cleverage/process-bundle & cleverage/*-process-bundle bridges",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "require": {
        "ext-intl": "*",
        "cleverage/archive-process-bundle": "^2.4",
        "cleverage/cache-process-bundle": "^2.4",
        "cleverage/doctrine-process-bundle": "^3.4",
        "cleverage/flysystem-process-bundle": "^3.4",
        "cleverage/process-bundle": "^5.5",
        "cleverage/rest-process-bundle": "^3.4",
        "cleverage/soap-process-bundle": "^3.4",
        "cleverage/ui-process-bundle": "^3.4",
        "doctrine/doctrine-migrations-bundle": "^3.7 || ^4",
        "league/flysystem-bundle": "^3.5",
        "league/flysystem-sftp-v3": "^3.0",
        "symfony/cache": "^6.4 || ^7.4 || ^8",
        "symfony/cache-contracts": "^3",
        "symfony/dotenv": "^6.4 || ^7.4 || ^8",
        "symfony/fake-chat-notifier": "^6.4 || ^7.4 || ^8",
        "symfony/flex": "^v2.3",
        "symfony/framework-bundle": "^6.4 || ^7.4 || ^8",
        "symfony/http-kernel": "^6.4 || ^7.4 || ^8",
        "symfony/monolog-bundle": "^3.11 || ^4",
        "symfony/notifier": "^6.4 || ^7.4 || ^8",
        "symfony/password-hasher": "^6.4 || ^7.4 || ^8",
        "symfony/process": "^6.4 || ^7.4 || ^8",
        "symfony/runtime": "^6.4 || ^7.4 || ^8",
        "symfony/scheduler": "^6.4 || ^7.4 || ^8",
        "symfony/stopwatch": "^6.4 || ^7.4 || ^8"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^3 || ^4",
        "friendsofphp/php-cs-fixer": "*",
        "phpstan/extension-installer": "*",
        "phpstan/phpstan": "*",
        "phpstan/phpstan-doctrine": "*",
        "phpstan/phpstan-symfony": "*",
        "phpunit/phpunit": "^10.5 || ^11 || ^12 || ^13",
        "rector/rector": "*",
        "roave/security-advisories": "dev-latest",
        "symfony/browser-kit": "^6.4 || ^7.4 || ^8",
        "symfony/css-selector": "^6.4 || ^7.4 || ^8",
        "symfony/debug-bundle": "^6.4 || ^7.4 || ^8",
        "symfony/maker-bundle": "^1.31",
        "symfony/web-profiler-bundle": "^6.4 || ^7.4 || ^8"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true,
        "preferred-install": {
            "cleverage/*": "source",
            "*": "dist"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "7.4.*"
        }
    }
}
