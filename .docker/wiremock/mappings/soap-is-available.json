{
  "name": "SOAP (non-WSDL, urn:demo): IsAvailable legitimately returns false",
  "request": {
    "method": "POST",
    "urlPath": "/soap",
    "headers": {
      "SOAPAction": {
        "contains": "#IsAvailable"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "text/xml; charset=utf-8"
    },
    "body": "<?xml version=\"1.0\" encoding=\"UTF-8\"?><SOAP-ENV:Envelope xmlns:SOAP-ENV=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:ns1=\"urn:demo\" xmlns:xsd=\"http://www.w3.org/2001/XMLSchema\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xmlns:SOAP-ENC=\"http://schemas.xmlsoap.org/soap/encoding/\" SOAP-ENV:encodingStyle=\"http://schemas.xmlsoap.org/soap/encoding/\"><SOAP-ENV:Body><ns1:IsAvailableResponse><return xsi:type=\"xsd:boolean\">false</return></ns1:IsAvailableResponse></SOAP-ENV:Body></SOAP-ENV:Envelope>"
  }
}
